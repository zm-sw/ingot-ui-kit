{
  "name": "@forgmatic/ingot",
  "version": "1.0.3",
  "description": "Ingot UI Kit — the Forgmatic admin design system. Source-distributed React + Tailwind primitives, plus the public doc web (ingot.forgmatic.com).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zm-sw/ingot-ui-kit.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/ingot/index.ts",
      "default": "./src/ingot/index.ts"
    },
    "./forgmatic": {
      "types": "./src/ingot/forgmatic/index.ts",
      "default": "./src/ingot/forgmatic/index.ts"
    },
    "./marketing": {
      "types": "./src/ingot/marketing.ts",
      "default": "./src/ingot/marketing.ts"
    },
    "./theme": {
      "types": "./src/ingot/theme.ts",
      "default": "./src/ingot/theme.ts"
    },
    "./tailwind-preset": {
      "types": "./src/ingot/tailwind-preset.ts",
      "default": "./src/ingot/tailwind-preset.ts"
    },
    "./theme-init.js": "./src/ingot/theme-init.js",
    "./tokens.css": "./src/ingot/tokens.css",
    "./tokens.json": "./src/ingot/tokens.json"
  },
  "files": [
    "src/ingot"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/ingot-docs/prerender.tsx --outDir dist-ssr && node scripts/prerender.mjs && node scripts/build-tokens.mjs --figma",
    "consumer:pack": "node scripts/pack-for-consumer.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "node scripts/checks.mjs && npm run lint && npm run format:check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "tokens": "node scripts/build-tokens.mjs"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^24.1.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.6",
    "vitest-axe": "^0.1.0"
  },
  "typesVersions": {
    "*": {
      "forgmatic": [
        "./src/ingot/forgmatic/index.ts"
      ],
      "marketing": [
        "./src/ingot/marketing.ts"
      ],
      "theme": [
        "./src/ingot/theme.ts"
      ],
      "tailwind-preset": [
        "./src/ingot/tailwind-preset.ts"
      ]
    }
  },
  "types": "./src/ingot/index.ts"
}
